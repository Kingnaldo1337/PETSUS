# Copie este arquivo para .env e substitua os valores antes de subir o servidor.

# Domínio público já apontado para o IP do servidor. Para teste local, use localhost.
PETSUS_DOMAIN=petsus.exemplo.com.br

# Primeiro gestor. Usado somente quando ainda não existe gestor no banco.
PETSUS_GESTOR_CPF=00000000000
PETSUS_GESTOR_SENHA=troque-por-uma-senha-forte
PETSUS_GESTOR_NOME=Administrador
PETSUS_GESTOR_DATA_NASCIMENTO=1990-01-01

# Opcional. Se ficar vazio, um segredo será criado no volume como usuarios.secret.
# Depois da primeira execução, nunca altere este valor nem perca usuarios.secret.
PETSUS_CPF_PEPPER=

# Servidor de e-mail usado no cadastro e na recuperação de senha.
PETSUS_SMTP_HOST=smtp.exemplo.com
PETSUS_SMTP_PORT=587
PETSUS_SMTP_USERNAME=usuario_smtp
PETSUS_SMTP_PASSWORD=troque-esta-senha
PETSUS_SMTP_FROM=nao-responda@exemplo.com.br
PETSUS_SMTP_SECURITY=starttls
